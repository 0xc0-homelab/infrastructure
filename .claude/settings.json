{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "extraKnownMarketplaces": {
    "0xc0-homelab": {
      "source": {
        "source": "github",
        "repo": "0xc0-homelab/claude-config"
      }
    },
    "hashicorp": {
      "source": {
        "source": "github",
        "repo": "hashicorp/agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "homelab@0xc0-homelab": true,
    "terraform@hashicorp": true
  },
  "permissions": {
    "allow": [
      "Bash(tofu plan:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu fmt:*)",
      "Bash(tofu show:*)",
      "Bash(packer validate:*)",
      "Bash(packer fmt:*)",
      "Bash(ansible-lint:*)",
      "Bash(ansible-inventory:*)"
    ],
    "deny": [
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)",
      "Read(./**/*.auto.tfvars)",
      "Read(./**/vault-pass*)",
      "Read(./**/*.age)",
      "Read(./**/age.key*)"
    ]
  }
}
