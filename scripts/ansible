#!/usr/bin/env bash
# Runs ansible-playbook with the vm-access tunnel token read from the OpenTofu
# state, and the secrets of secrets/ansible.sops.yaml, straight into the
# environment — never onto disk.
# Usage: scripts/ansible playbooks/vm-access.yml --check --diff
set -euo pipefail
cd "$(dirname "$0")/.."

token="$(sops exec-env secrets/tofu.sops.yaml 'tofu -chdir=environments/prod output -raw vm_access_tunnel_token')"
export CLOUDFLARED_TUNNEL_TOKEN="$token"

GITHUB_RUNNER_APP_PRIVATE_KEY="$(sops decrypt --extract '["github_runner_app_private_key"]' secrets/ansible.sops.yaml)"
export GITHUB_RUNNER_APP_PRIVATE_KEY

cd ansible
exec ansible-playbook "$@"
