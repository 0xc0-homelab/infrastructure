#!/usr/bin/env bash
# Runs ansible-playbook with the tunnel tokens and the admin SSH keys read
# from the OpenTofu state, and the playbooks' secrets read from Vault
# (scripts/vault-env), straight into the environment — never onto disk.
# Usage: scripts/ansible playbooks/vm-access.yml --check --diff
set -euo pipefail
cd "$(dirname "$0")/.."

. scripts/vault-env
vault_env_state
vault_env GITHUB_RUNNER_APP_PRIVATE_KEY infrastructure/runner-app private_key
vault_env RKE2_TOKEN infrastructure/rke2 token
vault_env ARGOCD_ADMIN_PASSWORD_BCRYPT infrastructure/argocd admin_password_bcrypt

# The admin tunnel's, for its connectors on vm-access-01 and vm-access-02.
ADMIN_TUNNEL_TOKEN="$(tofu -chdir=environments/prod output -raw admin_tunnel_token)"
export ADMIN_TUNNEL_TOKEN

# The public tunnel's, for its connectors on the load balancers.
PUBLIC_TUNNEL_TOKEN="$(tofu -chdir=environments/prod output -raw public_tunnel_token)"
export PUBLIC_TUNNEL_TOKEN

# The admin keys, as JSON: vm_admin_ssh_keys in terraform.tfvars is the one
# list, for cloud-init and for the base role alike.
HOMELAB_ADMIN_SSH_KEYS="$(tofu -chdir=environments/prod output -json vm_admin_ssh_keys)"
export HOMELAB_ADMIN_SSH_KEYS

# The plays go one host at a time (serial), so a bad change stops at the first
# and the other keeps the service. A dry run changes nothing: every host at once.
case " $* " in
  *" --check "*) set -- -e homelab_serial=100% "$@" ;;
esac

cd ansible
exec ansible-playbook "$@"
