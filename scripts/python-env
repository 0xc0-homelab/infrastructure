# shellcheck shell=bash
# Sourced, from the repo's root, by the wrappers the pipeline calls
# (scripts/ansible, and scripts/packer for its Ansible provisioner), like
# scripts/vault-env: it only defines python_env. That installs exactly uv.lock
# into .venv, every package checked against its hash, wheels only, then puts
# it first on PATH. Nothing is resolved here: a new release of a dependency
# changes nothing until a PR updates the lock.
# Usage: . scripts/python-env; python_env [--group lint]

# A function, not top-level code: a sourced file's "$@" is its caller's
# arguments, which would reach uv sync.
python_env() {
  uv sync --frozen --quiet "$@"
  PATH="$PWD/.venv/bin:$PATH"
  export PATH
}
