#!/usr/bin/env bash
# Regenerates environments/prod/firewall.tf from the transit matrix in
# docs/zones.md. Dependencies pinned; uv comes from mise.toml.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run --quiet --no-project --python 3.13 --with 'pyyaml==6.0.2' python scripts/generate-firewall.py
