# {{ ansible_managed }}

global_defs {
    enable_script_security
    script_user root
}

vrrp_script track_{{ keepalived_track_service }} {
    script "/usr/bin/systemctl is-active --quiet {{ keepalived_track_service }}"
    interval 2
    fall 2
    rise 2
}

# Both start as BACKUP; the highest priority with a healthy service wins.
vrrp_instance vip {
    state BACKUP
    interface {{ keepalived_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority }}
    advert_int 1

    unicast_src_ip {{ keepalived_source_address }}
    unicast_peer {
{% for peer in keepalived_peers %}
        {{ peer }}
{% endfor %}
    }

    # Every VIP in one instance: they always move together.
    virtual_ipaddress {
{% for vip in keepalived_vips %}
        {{ vip }} dev {{ keepalived_interface }}
{% endfor %}
    }

    track_script {
        track_{{ keepalived_track_service }}
    }
}
