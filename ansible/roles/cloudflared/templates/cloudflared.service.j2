# {{ ansible_managed }}
[Unit]
Description=cloudflared connector for a remotely managed tunnel
After=network-online.target
Wants=network-online.target

[Service]
# systemd reads the token as root, then drops to a throwaway user.
EnvironmentFile=/etc/cloudflared/tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel --protocol {{ cloudflared_protocol }} --grace-period 5s run
# WARP sessions are long-lived and never drain on their own: without a cap, a
# stop waited for systemd's 90s default and a SIGKILL. The other connector
# carries the sessions meanwhile.
TimeoutStopSec=15s
Restart=on-failure
RestartSec=5s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
