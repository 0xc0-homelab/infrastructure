# {{ ansible_managed }}
[Unit]
Description=cloudflared connector for a remotely managed tunnel
After=network-online.target
Wants=network-online.target

[Service]
# systemd reads the token as root, then drops to a throwaway user.
EnvironmentFile=/etc/cloudflared/tunnel.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5s
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
