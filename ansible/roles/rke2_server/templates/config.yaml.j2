# {{ ansible_managed }}
{% if rke2_server_join %}
server: https://{{ rke2_server_registration_address }}:9345
{% endif %}
token: "{{ rke2_server_token }}"
node-ip: {{ rke2_server_node_ip }}
{% if rke2_server_tls_san %}
tls-san:
{% for san in rke2_server_tls_san %}
  - {{ san }}
{% endfor %}
{% endif %}
selinux: true
ingress-controller: {{ rke2_server_ingress_controller }}
write-kubeconfig-mode: "0600"
# The control plane's metrics, on the node's address, for the OpenObserve
# collector (gitops, openobserve-collector): etcd's over plain HTTP on 2381,
# the scheduler's (10259) and the controller manager's (10257) over HTTPS,
# behind the API's authorization. The zone firewall admits them from platform
# only.
etcd-expose-metrics: true
kube-scheduler-arg:
  - bind-address=0.0.0.0
kube-controller-manager-arg:
  - bind-address=0.0.0.0
