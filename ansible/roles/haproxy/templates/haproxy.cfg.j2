# {{ ansible_managed }}

global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 5s
    timeout client {{ haproxy_timeout }}
    timeout server {{ haproxy_timeout }}
    default-server inter 3s fall 3 rise 2
{% for frontend in haproxy_frontends if not (frontend.internal | default(false)) or haproxy_internal_address %}

frontend {{ frontend.name }}
    bind {{ haproxy_internal_address if frontend.internal | default(false) else haproxy_listen_address }}:{{ frontend.port }}
    default_backend {{ frontend.name }}

backend {{ frontend.name }}
    balance roundrobin
{% for backend in haproxy_backends %}
    server {{ backend.name }} {{ backend.address }}:{{ frontend.backend_port }} check
{% endfor %}
{% endfor %}
