# {{ ansible_managed }}
# The cluster's boot secrets, from SOPS. Each namespace is gitops's; RKE2
# retries until it exists.
{% for secret in cluster_secrets_items %}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ secret.name }}
  namespace: {{ secret.namespace }}
type: Opaque
stringData:
{% for key, value in secret.data.items() %}
  {{ key }}: {{ value | to_json }}
{% endfor %}
{% endfor %}
