#!/usr/bin/env bash
# {{ ansible_managed }}
# Fetches a just-in-time config for runner instance $1 and leaves it where only
# the runner user can read it. Runs as root, before every start. The App's key
# never comes here: Vault signs the App's JWT with it (Transit), after an
# AppRole login with a secret ID only root can read, which jobs never see.
#
# No secret goes on a command line, where any process on the VM could read it
# (/proc/<pid>/cmdline), a job on the other instance included: request bodies
# go through stdin, and auth headers through a file descriptor.
set -euo pipefail
instance="$1"
# shellcheck disable=SC1091
. /etc/github-runner/app.env
secret_id=/etc/github-runner/approle-secret-id
api=https://api.github.com

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((now - 60)) $((now + 540)) "$GITHUB_APP_ID" | b64url)

# A batch token that lives a minute and can only sign with the App's key.
vault_token=$(jq -n --arg role_id "$VAULT_ROLE_ID" --rawfile secret_id "$secret_id" \
    '{role_id: $role_id, secret_id: ($secret_id | rtrimstr("\n"))}' |
  curl -fsS -X POST -H "Content-Type: application/json" --data-binary @- \
    "$VAULT_ADDR/v1/auth/approle/login" |
  jq -r .auth.client_token)
[ -n "$vault_token" ] && [ "$vault_token" != null ] || { echo "AppRole login to $VAULT_ADDR failed" >&2; exit 1; }

# PKCS#1 v1.5 over SHA-256 is RS256. Transit answers vault:v<n>:<base64>; the
# JWT takes the same bytes as base64url.
signature=$(jq -n --arg input "$(printf '%s.%s' "$header" "$payload" | openssl base64 -A)" \
    '{input: $input, signature_algorithm: "pkcs1v15"}' |
  curl -fsS -X POST -H @<(printf 'X-Vault-Token: %s\n' "$vault_token") \
    -H "Content-Type: application/json" --data-binary @- \
    "$VAULT_ADDR/v1/transit/sign/$VAULT_TRANSIT_KEY/sha2-256" |
  jq -r .data.signature | cut -d: -f3 | openssl base64 -d -A | b64url)
[ -n "$signature" ] || { echo "Transit did not sign with $VAULT_TRANSIT_KEY" >&2; exit 1; }
jwt="$header.$payload.$signature"

gh_api() {
  local method="$1" path="$2" auth="$3"; shift 3
  curl -fsS -X "$method" -H @<(printf 'Authorization: Bearer %s\n' "$auth") \
    -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" \
    "$@" "$api$path"
}

# The organization is the account the App is installed on, by its current
# name: renaming the org changes nothing here.
GITHUB_ORG=$(gh_api GET "/app/installations/$GITHUB_APP_INSTALLATION_ID" "$jwt" | jq -r .account.login)
[ -n "$GITHUB_ORG" ] && [ "$GITHUB_ORG" != null ] || { echo "App installation $GITHUB_APP_INSTALLATION_ID has no account" >&2; exit 1; }
token=$(gh_api POST "/app/installations/$GITHUB_APP_INSTALLATION_ID/access_tokens" "$jwt" | jq -r .token)
# The first of the group names that exists (space-separated): a group can be
# renamed without the runners losing it.
group_id=$(gh_api GET "/orgs/$GITHUB_ORG/actions/runner-groups?per_page=100" "$token" |
  jq -r --arg names "$GITHUB_RUNNER_GROUP" \
    '[($names | split(" "))[] as $n | .runner_groups[] | select(.name == $n) | .id][0] // empty')
[ -n "$group_id" ] || { echo "runner group $GITHUB_RUNNER_GROUP not found" >&2; exit 1; }

# A runner killed before its job (a restart, a reboot) cannot deregister
# itself. Drop this instance's offline registrations before making a new one.
gh_api GET "/orgs/$GITHUB_ORG/actions/runner-groups/$group_id/runners?per_page=100" "$token" |
  jq -r --arg prefix "$(hostname)-$instance-" \
    '.runners[] | select(.status == "offline" and (.name | startswith($prefix))) | .id' |
  while read -r stale; do
    gh_api DELETE "/orgs/$GITHUB_ORG/actions/runners/$stale" "$token" >/dev/null
  done

body=$(jq -n --arg name "$(hostname)-$instance-$now" --argjson group "$group_id" \
  --argjson labels "$GITHUB_RUNNER_LABELS" \
  '{name: $name, runner_group_id: $group, labels: $labels, work_folder: "_work"}')
config=$(gh_api POST "/orgs/$GITHUB_ORG/actions/runners/generate-jitconfig" "$token" -d "$body" |
  jq -r .encoded_jit_config)

install -d -o runner -g runner -m 0700 /run/github-runner
install -o runner -g runner -m 0600 /dev/null "/run/github-runner/$instance.jit"
printf '%s' "$config" > "/run/github-runner/$instance.jit"
